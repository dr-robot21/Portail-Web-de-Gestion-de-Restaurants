# ── Laravel / App ────────────────────────────────────────────
APP_NAME="Restaurant Portal"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-app.up.railway.app

# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Database (free MySQL host, e.g. Clever Cloud, Aiven, Railway) ──
DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=your-db-name
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password

# ── JWT (run `php artisan jwt:secret` to generate) ──────────
JWT_SECRET=
JWT_TTL=1440
JWT_REFRESH_TTL=20160

# ── Sessions / Cache / Queue ────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Filesystem ──────────────────────────────────────────────
# local keeps uploads on the container disk (lost on redeploy).
# For persistence use S3-compatible storage:
#   FILESYSTEM_DISK=s3
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_DEFAULT_REGION=...
#   AWS_BUCKET=...
FILESYSTEM_DISK=local

# ── Mail ────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@restaurant-portal.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Logging ─────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning
